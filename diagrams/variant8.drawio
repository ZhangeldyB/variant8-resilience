<mxfile host="app.diagrams.net" agent="variant8" version="24.0.0"><diagram id="p0" name="1. Архитектура как есть (SPOF)"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value="Вариант 8. IoT-пожаротушение склада — архитектура «как есть». Красное — единственный экземпляр (SPOF)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1100" height="30" as="geometry"/></mxCell><mxCell id="c4" value="Датчики дыма / тепла / пламени&lt;br&gt;(по 2 на секцию)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="30" y="160" width="150" height="70" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;A — контроллер склада&lt;/b&gt;&lt;br&gt;(edge-шлюз, 1 шт.)&lt;br&gt;MTBF 1480 ч / MTTR 3 ч" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="260" y="150" width="190" height="90" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;B — сервер платформы&lt;/b&gt;&lt;br&gt;MQTT-брокер + сервис правил (1 шт.)&lt;br&gt;MTBF 5700 ч / MTTR 1 ч" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="540" y="150" width="190" height="90" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;C — облачная аналитика&lt;/b&gt;&lt;br&gt;(внешний SaaS, dep-a)&lt;br&gt;SLA 0,995" style="ellipse;shape=cloud;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="820" y="130" width="220" height="130" as="geometry"/></mxCell><mxCell id="c8" value="Клапаны секций +&lt;br&gt;пожарный насос (1, электро)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="260" y="340" width="190" height="70" as="geometry"/></mxCell><mxCell id="c9" value="Шлюз оповещения&lt;br&gt;ПЦН / 101 (1 канал GSM)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="540" y="340" width="190" height="70" as="geometry"/></mxCell><mxCell id="c10" value="БД телеметрии&lt;br&gt;(1 сервер)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=12;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="820" y="330" width="140" height="90" as="geometry"/></mxCell><mxCell id="c11" value="Дашборд оператора" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1000" y="340" width="140" height="70" as="geometry"/></mxCell><mxCell id="c12" value="MQTT" style="endArrow=block;html=1;strokeWidth=3;strokeColor=#b85450;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c13" value="1" style="endArrow=block;html=1;strokeWidth=3;strokeColor=#b85450;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c14" value="2 подтвердить очаг?" style="endArrow=block;html=1;strokeWidth=3;strokeColor=#b85450;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="c6" target="c7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c15" value="3 ждём до 10 с" style="endArrow=block;html=1;strokeWidth=3;strokeColor=#b85450;curved=1;" edge="1" parent="1" source="c7" target="c5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c16" value="4 открыть клапан" style="endArrow=block;html=1;strokeWidth=3;strokeColor=#b85450;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="c5" target="c8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c17" value="тревога" style="endArrow=block;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="c5" target="c9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c18" value="" style="endArrow=block;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="c6" target="c10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c19" value="правила" style="endArrow=block;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="c11" target="c6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c20" value="Путь тревоги (жирные красные стрелки) последовательный: датчик → A → B → C → A → клапан.&lt;br&gt;Доступность цепочки 0,9928 ≈ 63 ч простоя в год (задание 4). Главная проблема: тревога ждёт облачную аналитику.&lt;br&gt;SPOF: A, B, C, насос, канал ПЦН, БД (+ одно электропитание)." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;" vertex="1" parent="1"><mxGeometry x="30" y="470" width="1100" height="120" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p1" name="2. Архитектура после (резервирование + Bulkhead)"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value="Архитектура после мер. Зелёный путь — тревога; серый пунктир — вспомогательная аналитика вне пути тревоги" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1100" height="30" as="geometry"/></mxCell><mxCell id="c4" value="Датчики&lt;br&gt;(2 на секцию)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="30" y="170" width="150" height="70" as="geometry"/></mxCell><mxCell id="c5" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#82b366;dashed=1;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="240" y="80" width="300" height="300" as="geometry"/></mxCell><mxCell id="c6" value="Hot standby 1+1 (heartbeat 1 с)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="250" y="85" width="280" height="20" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;A1 — контроллер (активный)&lt;/b&gt;&lt;br&gt;отсек тревог: правило «2 из 2»&lt;br&gt;отсек аналитики: R = 4 слота, таймаут 1 с" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="260" y="115" width="260" height="110" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;A2 — контроллер (резервный)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="260" y="250" width="260" height="60" as="geometry"/></mxCell><mxCell id="c9" value="ППКП (релейная логика) — разнообразный резерв" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="260" y="320" width="260" height="50" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;B — кластер брокера&lt;/b&gt;&lt;br&gt;3 узла (N+1)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="620" y="110" width="210" height="80" as="geometry"/></mxCell><mxCell id="c11" value="C — облачная аналитика&lt;br&gt;(не дублируется)" style="ellipse;shape=cloud;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;" vertex="1" parent="1"><mxGeometry x="900" y="90" width="220" height="120" as="geometry"/></mxCell><mxCell id="c12" value="Клапаны секций&lt;br&gt;Насос электро + насос дизель&lt;br&gt;(diversity)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="620" y="260" width="210" height="80" as="geometry"/></mxCell><mxCell id="c13" value="Канал ПЦН / 101:&lt;br&gt;провод + GSM 2-го оператора" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="620" y="400" width="210" height="70" as="geometry"/></mxCell><mxCell id="c14" value="БД телеметрии&lt;br&gt;бэкап 3-2-1-1-0&lt;br&gt;(cold standby)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="900" y="260" width="150" height="90" as="geometry"/></mxCell><mxCell id="c15" value="Питание: ИБП 2 ч + ДГУ&lt;br&gt;(diversity)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="900" y="400" width="220" height="70" as="geometry"/></mxCell><mxCell id="c16" value="MQTT, mTLS" style="endArrow=block;html=1;strokeWidth=3;strokeColor=#82b366;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="c4" target="c7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c17" value="открыть клапан ≤ 50 мс" style="endArrow=block;html=1;strokeWidth=3;strokeColor=#82b366;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="c7" target="c12"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c18" value="тревога" style="endArrow=block;html=1;strokeWidth=3;strokeColor=#82b366;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="c7" target="c13"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c19" value="конфиг, журнал" style="endArrow=block;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="c7" target="c10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c20" value="≤ 4 вызова, ≤ 1 с" style="endArrow=block;html=1;dashed=1;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="c7" target="c11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c21" value="сухой контакт" style="endArrow=block;html=1;dashed=1;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="c4" target="c9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c22" value="" style="endArrow=block;html=1;dashed=1;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="c9" target="c12"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c23" value="" style="endArrow=block;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="c10" target="c14"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p2" name="3. RBD: доступность A-B-C"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value="Блок-схемы надёжности (задание 4)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1100" height="30" as="geometry"/></mxCell><mxCell id="c4" value="Сейчас: последовательно" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="50" width="400" height="20" as="geometry"/></mxCell><mxCell id="c5" value="A 0,997977" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="160" height="60" as="geometry"/></mxCell><mxCell id="c6" value="B 0,999825" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="260" y="80" width="160" height="60" as="geometry"/></mxCell><mxCell id="c7" value="C 0,995" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="480" y="80" width="160" height="60" as="geometry"/></mxCell><mxCell id="c8" value="" style="endArrow=block;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c9" value="" style="endArrow=block;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="c6" target="c7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c10" value="A = 0,992813 → 63,0 ч простоя в год" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="680" y="90" width="450" height="40" as="geometry"/></mxCell><mxCell id="c11" value="Дублированы A и B, C в цепочке" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="180" width="400" height="20" as="geometry"/></mxCell><mxCell id="c12" value="A1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="40" y="210" width="160" height="50" as="geometry"/></mxCell><mxCell id="c13" value="A2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="40" y="280" width="160" height="50" as="geometry"/></mxCell><mxCell id="c14" value="B1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="260" y="210" width="160" height="50" as="geometry"/></mxCell><mxCell id="c15" value="B2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="260" y="280" width="160" height="50" as="geometry"/></mxCell><mxCell id="c16" value="C 0,995" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="480" y="245" width="160" height="50" as="geometry"/></mxCell><mxCell id="c17" value="" style="endArrow=block;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="c12" target="c14"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c18" value="" style="endArrow=block;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="c12" target="c15"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c19" value="" style="endArrow=block;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="c13" target="c14"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c20" value="" style="endArrow=block;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="c13" target="c15"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c21" value="" style="endArrow=block;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="c14" target="c16"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c22" value="" style="endArrow=block;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="c15" target="c16"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c23" value="A = 0,9999959 × 0,99999997 × 0,995 = 0,994996 → 43,8 ч&lt;br&gt;C даёт 98% простоя" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="680" y="240" width="450" height="60" as="geometry"/></mxCell><mxCell id="c24" value="После Bulkhead: путь тревоги без C" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="380" width="400" height="20" as="geometry"/></mxCell><mxCell id="c25" value="A1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="40" y="410" width="160" height="50" as="geometry"/></mxCell><mxCell id="c26" value="A2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="40" y="480" width="160" height="50" as="geometry"/></mxCell><mxCell id="c27" value="Клапан" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="260" y="445" width="160" height="50" as="geometry"/></mxCell><mxCell id="c28" value="" style="endArrow=block;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="c25" target="c27"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c29" value="" style="endArrow=block;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="c26" target="c27"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c30" value="C — вне пути" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;" vertex="1" parent="1"><mxGeometry x="480" y="445" width="160" height="50" as="geometry"/></mxCell><mxCell id="c31" value="A = 1 − (1 − 0,997977)² = 0,9999959 → 2,2 мин в год" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="680" y="440" width="450" height="60" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p3" name="4. Матрица рисков 5x5"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value="Матрица рисков 5×5 (задание 3): вероятность × воздействие" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1000" height="30" as="geometry"/></mxCell><mxCell id="c4" value="5" style="text;html=1;align=center;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="80" y="100" width="50" height="30" as="geometry"/></mxCell><mxCell id="c5" value="5" style="whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#666666;fontSize=13;" vertex="1" parent="1"><mxGeometry x="