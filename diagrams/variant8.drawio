mxCell id="c34" value="1" style="text;html=1;align=center;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="180" y="615" width="30" height="30" as="geometry"/></mxCell><mxCell id="c35" value="2" style="text;html=1;align=center;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="290" y="615" width="30" height="30" as="geometry"/></mxCell><mxCell id="c36" value="3" style="text;html=1;align=center;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="400" y="615" width="30" height="30" as="geometry"/></mxCell><mxCell id="c37" value="4" style="text;html=1;align=center;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="510" y="615" width="30" height="30" as="geometry"/></mxCell><mxCell id="c38" value="5" style="text;html=1;align=center;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="620" y="615" width="30" height="30" as="geometry"/></mxCell><mxCell id="c39" value="Воздействие →" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="140" y="650" width="550" height="25" as="geometry"/></mxCell><mxCell id="c40" value="Вероятность ↑" style="text;html=1;fontSize=14;fontStyle=1;rotation=-90;" vertex="1" parent="1"><mxGeometry x="10" y="280" width="60" height="30" as="geometry"/></mxCell><mxCell id="c41" value="15–25: критический — обрабатывать первым (R1, R2)&lt;br&gt;&lt;br&gt;8–14: высокий / средний — план мер (R3–R8)&lt;br&gt;&lt;br&gt;1–7: низкий — можно принять (R8 после мер: 2×2 = 4)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;" vertex="1" parent="1"><mxGeometry x="720" y="80" width="400" height="200" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p4" name="5. Fault → Error → Failure"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value="Цепочки fault → error → failure (задание 4). Алерты ставятся на симптом — failure" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1000" height="30" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;Fault&lt;/b&gt;&lt;br&gt;синхронный вызов облачной аналитики без таймаута" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="280" height="80" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;Error&lt;/b&gt;&lt;br&gt;все потоки контроллера ждут 4+ с" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="420" y="80" width="280" height="80" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;Failure&lt;/b&gt;&lt;br&gt;клапан открывается с опозданием" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="800" y="80" width="280" height="80" as="geometry"/></mxCell><mxCell id="c7" value="" style="endArrow=block;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c8" value="" style="endArrow=block;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;Fault&lt;/b&gt;&lt;br&gt;истёк сертификат шлюза ПЦН" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="40" y="230" width="280" height="80" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;Error&lt;/b&gt;&lt;br&gt;ошибка TLS-рукопожатия" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="420" y="230" width="280" height="80" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;Failure&lt;/b&gt;&lt;br&gt;тревога не доходит до 101" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="800" y="230" width="280" height="80" as="geometry"/></mxCell><mxCell id="c12" value="" style="endArrow=block;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="c9" target="c10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c13" value="" style="endArrow=block;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="c10" target="c11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c14" value="Алерт 1 (page): p99 «датчик → клапан» &gt; 2 с за 1 мин или тревога без подтверждения клапана&lt;br&gt;Алерт 2 (ticket): отклонено &gt; 20% вызовов аналитики за 10 мин" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="800" y="340" width="320" height="100" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p5" name="6. План Kubernetes"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value="План Kubernetes (задание 7): edge-кластер k3s, 3 узла в 3 стойках" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1100" height="30" as="geometry"/></mxCell><mxCell id="c4" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#666666;dashed=1;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="340" height="330" as="geometry"/></mxCell><mxCell id="c5" value="Узел 1 / стойка 1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="50" y="65" width="320" height="20" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;alarm-core&lt;/b&gt; (реплика 1)&lt;br&gt;QoS Guaranteed, PriorityClass fire-critical&lt;br&gt;readiness: процесс + брокер; liveness: процесс" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="60" y="100" width="300" height="90" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;analytics-adapter&lt;/b&gt;&lt;br&gt;Burstable, низкий приоритет, HPA 1–4" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;" vertex="1" parent="1"><mxGeometry x="60" y="210" width="300" height="70" as="geometry"/></mxCell><mxCell id="c8" value="mqtt-broker (узел кластера 1)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="60" y="300" width="300" height="60" as="geometry"/></mxCell><mxCell id="c9" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#666666;dashed=1;" vertex="1" parent="1"><mxGeometry x="410" y="60" width="340" height="330" as="geometry"/></mxCell><mxCell id="c10" value="Узел 2 / стойка 2" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="420" y="65" width="320" height="20" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;alarm-core&lt;/b&gt; (реплика 2)&lt;br&gt;QoS Guaranteed, PriorityClass fire-critical&lt;br&gt;readiness: процесс + брокер; liveness: процесс" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="430" y="100" width="300" height="90" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;analytics-adapter&lt;/b&gt;&lt;br&gt;Burstable, низкий приоритет, HPA 1–4" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;" vertex="1" parent="1"><mxGeometry x="430" y="210" width="300" height="70" as="geometry"/></mxCell><mxCell id="c13" value="mqtt-broker (узел кластера 2)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="430" y="300" width="300" height="60" as="geometry"/></mxCell><mxCell id="c14" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#666666;dashed=1;" vertex="1" parent="1"><mxGeometry x="780" y="60" width="340" height="330" as="geometry"/></mxCell><mxCell id="c15" value="Узел 3 / стойка 3" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="790" y="65" width="320" height="20" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;alarm-core&lt;/b&gt; (реплика 3)&lt;br&gt;QoS Guaranteed, PriorityClass fire-critical&lt;br&gt;readiness: процесс + брокер; liveness: процесс" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="800" y="100" width="300" height="90" as="geometry"/></mxCell><mxCell id="c17" value="mqtt-broker (узел кластера 3)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="800" y="300" width="300" height="60" as="geometry"/></mxCell><mxCell id="c18" value="PDB alarm-core: minAvailable 2 · RollingUpdate maxSurge 1 / maxUnavailable 0 + канарейка 24 ч · topologySpreadConstraints по стойкам · NetworkPolicy: топик клапанов только у alarm-core · ResourceQuota отдельно для namespace аналитики · команды клапанам — CP (Lease-лидер, идемпотентность), аналитика — AP.&lt;br&gt;Бюджет таймаутов: клиент 1,5 с → решение по тревоге &amp;lt; 50 мс → аналитика ≤ 1,0 с без повторов." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="410" width="1100" height="140" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p6" name="7. Стенд Killercoda"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value="Эксперимент: dep-a тормозит на 4000 мс в окне 30–60 с, PATTERN=off / on" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1100" height="30" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;loadgen.py&lt;/b&gt;&lt;br&gt;20 запросов/с, ждёт ≤ 1,5 с&lt;br&gt;→ results/*.csv" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="220" height="90" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;core.py&lt;/b&gt;&lt;br&gt;отсек тревог: локальное решение&lt;br&gt;отсек аналитики: Bulkhead R = 4, таймаут 1 с" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="360" y="80" width="300" height="130" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;dep-a&lt;/b&gt; (облачная аналитика)&lt;br&gt;FAULT {&quot;delay_ms&quot;: 4000}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="760" y="100" width="220" height="90" as="geometry"/></mxCell><mxCell id="c7" value="HTTP" style="endArrow=block;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c8" value="≤ 4 одновременно" style="endArrow=block;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c9" value="0–30 с: норма" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="40" y="280" width="300" height="40" as="geometry"/></mxCell><mxCell id="c10" value="30–60 с: dep-a +4000 мс" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="340" y="280" width="300" height="40" as="geometry"/></mxCell><mxCell id="c11" value="60–120 с: восстановление" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="640" y="280" width="340" height="40" as="geometry"/></mxCell><mxCell id="c12" value="Без паттерна каждый запрос в окне отказа ждёт 4 с &gt; 1,5 с → ошибка у клиента. С паттерном: ≤ 4 запроса ждут 1 с и получают degraded, остальные получают ответ сразу." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="350" width="1000" height="60" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>